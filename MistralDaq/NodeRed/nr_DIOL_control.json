    {
        "id": "3f8fce2dae9b511b",
        "type": "function",
        "z": "d12212b3f661e7bc",
        "name": "Control Logic (Hysteresis)",
        "func": "let T = msg.temperature;\n\nlet T_open = 10;\n\nlet state = flow.get(\"valve_state\") || \"INIT\";\n\nstate = \"CLOSED\";\nif (T > T_open) {\n    state = \"OPEN\";\n}\n\nflow.set(\"valve_state\", state);\n\nmsg.state = state;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
