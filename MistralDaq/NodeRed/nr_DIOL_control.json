    {
        "id": "87d63778478009f3",
        "type": "function",
        "z": "d12212b3f661e7bc",
        "name": "function test",
        "func": "let data = msg.payload.data || msg.payload;\n\nlet raw = Number(data[4]);   // T_pump_in is index 0\n\nif (Number.isFinite(raw)) {\n    if (raw > 32767) {\n        raw = raw - 65536;   // signed conversion\n    }\n    msg.temperature = raw * 0.0977;\n} else {\n    msg.temperature = null;\n}\n\nreturn msg;",
