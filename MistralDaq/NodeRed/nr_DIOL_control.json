    {
        "id": "f77083ad9ba3655a",
        "type": "function",
        "z": "d12212b3f661e7bc",
        "name": "msg to DIOL",
        "func": "let state = msg.state;\n\n// DIOL logic:\n// 0 = switch closed → current flows → valve OPEN\n// 1 = switch open   → no current    → valve CLOSED\n\nlet value = (state === \"OPEN\") ? 0 : 1;\n\n// Apply same command to 5 DO channels\nmsg.payload = {\n    fc: 16,\n    unitid: 1,\n    address: 13000,\n    quantity: 5,\n    value: [1,1,1,1,1]\n};\n\nreturn msg;",
        "outputs": 1,
