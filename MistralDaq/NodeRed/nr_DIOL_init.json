    {
        "id": "bb232d9a399eecbb",
        "type": "function",
        "z": "da58ef89501cdc67",
        "name": "msg to DIOL",
        "func": "let state = msg.state;\n\n// DIOL logic:\n// 0 = switch closed → current flows → valve OPEN\n// 1 = switch open   → no current    → valve CLOSED\n\nlet value = (state === \"CLOSE\") ? 0 : 1;\n\n// Apply same command to 5 DO channels\nmsg.payload = {\n    fc: 16,\n    unitid: 1,\n    address: 13000,\n    quantity: 5,\n    value: [value, value, value, value, value]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 220,
        "wires": [
